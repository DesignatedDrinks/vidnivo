# All VITE_* variables are visible in the built website.
# These are PUBLIC Firebase web identifiers, not service-account keys.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_APP_ID=
# Keep empty to use Firebase Hosting /api/** rewrite.
# For local dev or separate Cloud Run URL use https://YOUR_SERVICE.run.app
VITE_API_BASE_URL=
