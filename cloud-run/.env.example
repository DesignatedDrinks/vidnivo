# Cloud Run sets GOOGLE_CLOUD_PROJECT automatically; no JSON key needed.
FIREBASE_STORAGE_BUCKET=YOUR_PROJECT_ID.firebasestorage.app
ALLOWED_ORIGINS=https://YOUR_PROJECT_ID.web.app,https://YOUR_PROJECT_ID.firebaseapp.com
PORT=8080

# Optional server-only OpenAI support. Store key in GCP Secret Manager, not this file.
OPENAI_SUPPORT_MODEL=gpt-5-mini
# OPENAI_SUPPORT_API_KEY is set only as a Cloud Run secret binding.
