# Google OAuth IDs are public identifiers, NOT client secrets.
# Register the Android package com.vidnivo.editor and iOS bundle ID.
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Firebase Web API key is public. Cloud Run service must use HTTPS.
# Full cloud backup requires an approved, deployed Firebase + Cloud Run project.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_CLOUD_API_BASE_URL=
