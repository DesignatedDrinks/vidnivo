rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Read-only from signed-in clients. All writes and deletion must go through
    // Cloud Run, which verifies Firebase identity and reserves storage quota.
    // Firebase Admin SDK does not use client Storage security rules.
    match /users/{userId}/media/{assetId}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update, delete: if false;
    }
    match /{object=**} {
      allow read, write: if false;
    }
  }
}
