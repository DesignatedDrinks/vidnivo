rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owns(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // The Cloud Run API exclusively creates/updates account profiles using
    // the Admin SDK. Users can only read their own profile directly.
    match /users/{uid} {
      allow get: if owns(uid);
      allow list, create, update, delete: if false;
    }

    // Legacy project metadata remains in Google Sheets during this phase.
    // Do NOT enable shared client writes to other Firestore collections.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
